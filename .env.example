# Copie para .env. Todas as variáveis são opcionais; sem chave de LLM o modo "base-local" é usado.

# Servidor
HOST=127.0.0.1
PORT=3004
ENVIRONMENT=development        # development | production | test
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console

# Banco (SQLite por padrão). DATABASE_PATH é aceito por compatibilidade com a versão Node.
DATABASE_URL=sqlite:///data/support.sqlite
AUTO_MIGRATE=true
SEED_DEMO_DATA=true

# Segurança
MAX_BODY_BYTES=49152
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITES_PER_MINUTE=60
RATE_LIMIT_SUGGEST_PER_MINUTE=12
HSTS_ENABLED=false             # ative apenas atrás de HTTPS
DOCS_ENABLED=true              # /docs e /openapi.json
# FORWARDED_ALLOW_IPS=10.0.0.0/8   # IPs de proxies confiáveis (X-Forwarded-For)

# Sugestões com modelo de linguagem (OpenAI Responses API). Preencha as duas para ativar.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=400
